{
  "name": "drum-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server:setup": "python3.12 -m venv server/.venv && server/.venv/bin/pip install -r server/requirements.txt",
    "server": "server/.venv/bin/python server/app.py",
    "eval": "server/.venv/bin/python server/eval.py"
  },
  "dependencies": {
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
